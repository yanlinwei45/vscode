{
  "name": "cursor-agent",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "vscode",
  "license": "MIT",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/activitybar.svg",
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:cursorAgent.sidebar",
    "onCommand:cursorAgent.open",
    "onCommand:cursorAgent.sendSelection",
    "onCommand:cursorAgent.sendCurrentFile",
    "onCommand:cursorAgent.sendProblems",
    "onCommand:cursorAgent.showLogs",
    "onCommand:cursorAgent.insertCodeBlock",
    "onCommand:cursorAgent.replaceSelectionWithCodeBlock",
    "onCommand:cursorAgent.previewInsertCodeBlock",
    "onCommand:cursorAgent.previewReplaceSelectionWithCodeBlock",
    "onCommand:cursorAgent.acceptProposal",
    "onCommand:cursorAgent.rejectProposal",
    "onCommand:cursorAgent.analyzeCurrentContext",
    "onCommand:cursorAgent.selectCurrentFunction",
    "onCommand:cursorAgent.selectCurrentBlock",
    "onCommand:cursorAgent.focusSelection",
    "onCommand:cursorAgent.askAboutSelection",
    "onCommand:cursorAgent.addSelectionToChat",
    "onCommand:cursorAgent.editSelection",
    "onCommand:cursorAgent.explainSelection",
    "onCommand:cursorAgent.fixCurrentFile"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursor-agent",
          "title": "%container.title%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "views": {
      "cursor-agent": [
        {
          "id": "cursorAgent.sidebar",
          "type": "webview",
          "name": "%view.name%",
          "icon": "media/activitybar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "cursorAgent.open",
        "title": "%command.open%",
        "category": "%command.category%"
      },
      {
        "command": "cursorAgent.sendSelection",
        "title": "%command.sendSelection%",
        "category": "%command.category%",
        "icon": "$(send)"
      },
      {
        "command": "cursorAgent.newChat",
        "title": "%command.newChat%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.sendCurrentFile",
        "title": "%command.sendCurrentFile%",
        "category": "%command.category%",
        "icon": "$(file-code)"
      },
      {
        "command": "cursorAgent.sendProblems",
        "title": "%command.sendProblems%",
        "category": "%command.category%",
        "icon": "$(warning)"
      },
      {
        "command": "cursorAgent.showLogs",
        "title": "%command.showLogs%",
        "category": "%command.category%",
        "icon": "$(output)"
      },
      {
        "command": "cursorAgent.insertCodeBlock",
        "title": "%command.insertCodeBlock%",
        "category": "%command.category%"
      },
      {
        "command": "cursorAgent.replaceSelectionWithCodeBlock",
        "title": "%command.replaceSelectionWithCodeBlock%",
        "category": "%command.category%"
      },
      {
        "command": "cursorAgent.previewInsertCodeBlock",
        "title": "%command.previewInsertCodeBlock%",
        "category": "%command.category%"
      },
      {
        "command": "cursorAgent.previewReplaceSelectionWithCodeBlock",
        "title": "%command.previewReplaceSelectionWithCodeBlock%",
        "category": "%command.category%"
      },
      {
        "command": "cursorAgent.acceptProposal",
        "title": "%command.acceptProposal%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "cursorAgent.rejectProposal",
        "title": "%command.rejectProposal%",
        "category": "%command.category%",
        "icon": "$(close)"
      },
      {
        "command": "cursorAgent.analyzeCurrentContext",
        "title": "%command.analyzeCurrentContext%",
        "category": "%command.category%",
        "icon": "$(lightbulb)"
      },
      {
        "command": "cursorAgent.selectCurrentFunction",
        "title": "%command.selectCurrentFunction%",
        "category": "%command.category%",
        "icon": "$(symbol-method)"
      },
      {
        "command": "cursorAgent.selectCurrentBlock",
        "title": "%command.selectCurrentBlock%",
        "category": "%command.category%",
        "icon": "$(selection)"
      },
      {
        "command": "cursorAgent.focusSelection",
        "title": "%command.focusSelection%",
        "category": "%command.category%",
        "icon": "$(target)"
      },
      {
        "command": "cursorAgent.askAboutSelection",
        "title": "%command.askAboutSelection%",
        "category": "%command.category%",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "cursorAgent.addSelectionToChat",
        "title": "%command.addSelectionToChat%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "cursorAgent.editSelection",
        "title": "%command.editSelection%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "cursorAgent.explainSelection",
        "title": "%command.explainSelection%",
        "category": "%command.category%",
        "icon": "$(comment)"
      },
      {
        "command": "cursorAgent.fixCurrentFile",
        "title": "%command.fixCurrentFile%",
        "category": "%command.category%",
        "icon": "$(wrench)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cursorAgent.addSelectionToChat",
          "when": "editorHasSelection"
        },
        {
          "command": "cursorAgent.editSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "cursorAgent.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "cursorAgent.askAboutSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "cursorAgent.selectCurrentFunction"
        },
        {
          "command": "cursorAgent.selectCurrentBlock"
        },
        {
          "command": "cursorAgent.sendCurrentFile"
        }
      ],
      "commandPalette": [
        {
          "command": "cursorAgent.open"
        },
        {
          "command": "cursorAgent.sendSelection"
        },
        {
          "command": "cursorAgent.newChat"
        },
        {
          "command": "cursorAgent.sendCurrentFile"
        },
        {
          "command": "cursorAgent.sendProblems"
        },
        {
          "command": "cursorAgent.showLogs"
        },
        {
          "command": "cursorAgent.acceptProposal"
        },
        {
          "command": "cursorAgent.rejectProposal"
        },
        {
          "command": "cursorAgent.analyzeCurrentContext"
        },
        {
          "command": "cursorAgent.selectCurrentFunction"
        },
        {
          "command": "cursorAgent.selectCurrentBlock"
        },
        {
          "command": "cursorAgent.focusSelection"
        },
        {
          "command": "cursorAgent.askAboutSelection"
        },
        {
          "command": "cursorAgent.editSelection"
        },
        {
          "command": "cursorAgent.explainSelection"
        },
        {
          "command": "cursorAgent.fixCurrentFile"
        }
      ],
      "view/title": [
        {
          "command": "cursorAgent.newChat",
          "when": "view == cursorAgent.sidebar",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Cursor 智能体",
      "properties": {
        "cursorAgent.systemPrompt": {
          "type": "string",
          "default": "你是 Cursor，一个在 VS Code 中工作的资深编码助手。请保持简洁、务实，并专注于代码与执行。",
          "description": "%config.systemPrompt.description%",
          "scope": "application"
        },
        "cursorAgent.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "description": "%config.model.description%",
          "scope": "application"
        },
        "cursorAgent.baseUrl": {
          "type": "string",
          "default": "",
          "description": "%config.baseUrl.description%",
          "scope": "application"
        }
      }
    }
  }
}
